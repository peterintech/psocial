PORT=8080
ENV=development
API_URL=localhost:8080
FRONTEND_URL=http://localhost:5173/
CORS_ALLOWED_ORIGIN=http://localhost:5173

DB_ADDR=postgres://postgres:postgres@localhost:5432/psocial?sslmode=disable
DB_MAX_OPEN_CONNS=30
DB_MAX_IDLE_CONNS=30
DB_MAX_IDLE_TIME=15m

REDIS_ADDR=localhost:6379
REDIS_PW=
REDIS_DB=0
REDIS_ENABLED=true

BASIC_AUTH_USER=admin
BASIC_AUTH_PASS=change-me
JWT_SECRET=change-me

RATE_LIMIT_REQUESTS_COUNT=20
RATE_LIMIT_ENABLED=true

# Use "smtp" for Gmail or "sendgrid" for the existing provider.
MAIL_PROVIDER=smtp
MAIL_FROM_NAME=Psocial
MAIL_FROM_EMAIL=your-account@gmail.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-account@gmail.com
SMTP_PASSWORD=your-google-app-password

SENDGRID_API_KEY=
